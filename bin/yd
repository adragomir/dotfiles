#!/bin/bash

trans="false"
if [[ "$0" == *"trans"* ]] ; then 
  trans="true"
fi

if [[ $# == 1 ]]; then
  url="$1"
  shift
elif [[ $# -ge 2 ]]; then
  sz="$1"
  shift
  url="${@: -1}"
  set -- "${@:1:$(($#-1))}"
fi

sz_arg="bestvideo*+bestaudio/best"
if [[ "$sz"  != "" ]]; then
  sz_arg="bestvideo[height<=$sz]+bestaudio/best[height<=$sz]"
fi

output_template="%(title)s [%(id)s].%(ext)s"
if [[ "$trans" == "true" ]]; then
  title=$(yt-dlp --extractor-args "youtube:lang=en" --print title "$url")
  trans_title=$(trans -b "${title}" | gsed 's!/!!g')
  output_template="${trans_title} - %(title)s [%(id)s].%(ext)s"
fi

recode_args=(
)
if [[ "${url}" == *"twitch"* ]]; then
  recode_args=(
    "--downloader"
    "ffmpeg"
    "--downloader-args"
    "ffmpeg:-c:v libx264 -crf 30 -preset medium"
  )
fi
echo yt-dlp --cookies-from-browser chrome --impersonate chrome -f $sz_arg --extractor-args "lang:en" --write-subs --write-automatic-subs --sub-langs en --sub-format srt "${recode_args[@]}"   -o "${output_template}" "$@" "$url"
yt-dlp --remote-components ejs:github --cookies-from-browser chrome --impersonate chrome -f $sz_arg --extractor-args "lang:en" --write-subs --write-automatic-subs --sub-langs en --sub-format srt "${recode_args[@]}" -o "${output_template}" "$@" "$url"
